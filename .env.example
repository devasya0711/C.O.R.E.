# Git & project identity
GIT_AUTHOR_NAME=devasya0711
GIT_AUTHOR_EMAIL=devasyakachru.007@gmail.com

# Local infrastructure (supply passwords locally; never commit .env)
POSTGRES_DB=core_db
POSTGRES_USER=core_user
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://core_user:replace_with_urlencoded_password@postgres:5432/core_db
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
# JWKS URL must be https://<your-clerk-domain>/.well-known/jwks.json
# Issuer defaults to the JWKS URL with /.well-known/jwks.json removed.
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# AI and encryption
OPENAI_API_KEY=
# Generate locally: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET_KEY=

# Frontend-to-API URL used by the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
HEALTH_PROBE_TIMEOUT_SECONDS=1.5
