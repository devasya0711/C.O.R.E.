# Git & project identity
GIT_AUTHOR_NAME=devasya0711
GIT_AUTHOR_EMAIL=devasyakachru.007@gmail.com

# Local infrastructure (supply passwords locally; never commit .env)
POSTGRES_DB=core_db
POSTGRES_USER=core_user
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://core_user:replace_with_urlencoded_password@postgres:5432/core_db
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
# JWKS URL must be https://<your-clerk-domain>/.well-known/jwks.json
# Issuer defaults to the JWKS URL with /.well-known/jwks.json removed.
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# AI and encryption
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
ANALYSIS_TIMEOUT_SECONDS=90
MIGRATION_TIMEOUT_SECONDS=300
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_DOCKER_EXECUTABLE=docker
SANDBOX_DOCKER_IMAGE=core-sandbox:latest
SANDBOX_DOCKER_MEMORY_MB=512
SANDBOX_DOCKER_CPUS=1.0
SANDBOX_DOCKER_PIDS_LIMIT=256
# Compose runs the isolated Docker sandbox. Set false only for direct local
# backend runs where the reduced-isolation subprocess fallback is intentional.
SANDBOX_REQUIRE_DOCKER=true
# Compose-only Docker socket settings. Set DOCKER_GID to the socket's group ID
# when the host socket is not readable by the container's supplementary group.
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_GID=0
GITHUB_TIMEOUT_SECONDS=15
# Local Python runs default to the workspace fixture. Compose mounts /sample_monolith.
# SAMPLE_MONOLITH_PATH=/absolute/path/to/sample_monolith
CLONE_TIMEOUT_SECONDS=30
INGESTION_TIMEOUT_SECONDS=90
INGESTION_MAX_SOURCE_BYTES=104857600
# Generate locally: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET_KEY=

# Frontend-to-API URL used by the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
HEALTH_PROBE_TIMEOUT_SECONDS=1.5
